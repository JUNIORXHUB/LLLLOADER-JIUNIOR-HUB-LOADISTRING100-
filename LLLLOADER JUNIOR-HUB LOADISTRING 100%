-- PARTÍCULAS DE FONDO
local Particles = {}
for i = 1, 30 do
    local p = Instance.new("Frame")
    p.BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(160, 50, 255) or Color3.fromRGB(240, 230, 255)
    p.BackgroundTransparency = 0.5
    p.BorderSizePixel = 0
    p.Size = UDim2.new(0, math.random(3, 6), 0, math.random(3, 6))
    p.Position = UDim2.new(math.random(), 0, math.random(), 0)
    p.Parent = FullScreen
    p.ZIndex = 101

    local pCorner = Instance.new("UICorner")
    pCorner.CornerRadius = UDim.new(1, 0)
    pCorner.Parent = p

    table.insert(Particles, {
        Frame = p,
        Vx = (math.random() - 0.5) * 0.005,
        Vy = (math.random() - 0.5) * 0.005
    })
end

local particleConnection
particleConnection = RunService.RenderStepped:Connect(function()
    if not FullScreen or not FullScreen.Parent then
        if particleConnection then particleConnection:Disconnect() end
        return
    end
    for _, d in ipairs(Particles) do
        local nx = d.Frame.Position.X.Scale + d.Vx
        local ny = d.Frame.Position.Y.Scale + d.Vy
        if nx < 0 or nx > 1 then d.Vx = -d.Vx end
        if ny < 0 or ny > 1 then d.Vy = -d.Vy end
        d.Frame.Position = UDim2.new(nx, 0, ny, 0)
    end
end)

