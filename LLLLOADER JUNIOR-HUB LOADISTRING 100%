-- EJECUTOR DE SCRIPTS PROTEGIDO
local function LoadScript(url, name)
    Status.Text = 'Estado: <font color="#d896ff">Cargando ' .. name .. '...</font>'
    task.spawn(function()
        local ok, rawContent = pcall(function()
            return game:HttpGet(url, true)
        end)
        
        if ok and rawContent and #rawContent > 0 and not rawContent:find("404: Not Found") then
            local execOk, execErr = pcall(function()
                local func = assert(loadstring(rawContent))
                func()
            end)
            
            if execOk then
                Status.Text = 'Estado: <font color="#50ff78">' .. name .. ' Ejecutado ✅</font>'
            else
                Status.Text = 'Estado: <font color="#ff5050">Error al ejecutar</font>'
                warn("Error de ejecucion:", execErr)
            end
        else
            Status.Text = 'Estado: <font color="#ff5050">URL no válida o 404 ❌</font>'
        end
    end)
end

